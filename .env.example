# Ticket Booking System - Environment Configuration Example

# Server settings
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///booking.db

# Security
SECRET_KEY=ticket_booking_system_super_secret_key_change_me_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Spool Directories
MAIL_SPOOL_DIR=mail_spool

# Optional Live SMTP Email Configuration
# If SMTP_HOST is configured, the system will send real emails with embedded QR codes.
# If omitted or left empty, the system will fall back to saving emails as local HTML files in mail_spool/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
